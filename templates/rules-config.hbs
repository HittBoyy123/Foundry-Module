<div class="cmt-config-body cmt-dashboard">
  <header class="cmt-config-header cmt-dashboard-masthead">
    <i class="fa-solid fa-hammer" aria-hidden="true"></i>
    <div>
      <h2>{{localize "CMT.Settings.Dashboard.Heading"}}</h2>
      <p>{{localize "CMT.Settings.Dashboard.Intro"}}</p>
    </div>
  </header>

  <section class="cmt-switch-grid" aria-label="{{localize 'CMT.Settings.Dashboard.Features'}}">
    <label class="cmt-setting-card">
      <span class="cmt-setting-icon"><i class="fa-solid fa-hammer" aria-hidden="true"></i></span>
      <strong>{{localize "CMT.Settings.Dashboard.Crafting"}}</strong>
      <input type="checkbox" name="crafting.enabled" {{#if craftingEnabled}}checked{{/if}}>
    </label>
    <label class="cmt-setting-card">
      <span class="cmt-setting-icon"><i class="fa-solid fa-basket-shopping" aria-hidden="true"></i></span>
      <strong>{{localize "CMT.Settings.Dashboard.Gathering"}}</strong>
      <input type="checkbox" name="gathering.enabled" {{#if gatheringEnabled}}checked{{/if}}>
    </label>
    <label class="cmt-setting-card">
      <span class="cmt-setting-icon"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i></span>
      <strong>{{localize "CMT.Settings.Dashboard.Hexploration"}}</strong>
      <input type="checkbox" name="hexploration.enabled" {{#if hexplorationEnabled}}checked{{/if}}>
    </label>
  </section>

  <section class="cmt-panel">
    <h3><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {{localize "CMT.Settings.Dashboard.GatheringOptions"}}</h3>
    <div class="cmt-gathering-settings-grid">
      <label class="cmt-dashboard-check">
        <strong>{{localize "CMT.Settings.Dashboard.SceneRegionIntegration"}}</strong>
        <input type="checkbox" name="gathering.useSceneRegion" {{#if gatheringUsesSceneRegion}}checked{{/if}}>
      </label>
      <label class="cmt-dashboard-select">
        <span>{{localize "CMT.Settings.Dashboard.ActiveEnvironment"}}</span>
        <select name="gathering.environmentId">
          {{#each gatheringEnvironments}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </label>
      <label class="cmt-dashboard-select">
        <span>{{localize "CMT.Settings.Dashboard.MaximumGatheringTier"}}</span>
        <select name="gathering.maxTier">
          {{#each gatheringTiers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>Tier {{value}}</option>{{/each}}
        </select>
      </label>
      <label class="cmt-dashboard-select">
        <span>{{localize "CMT.Settings.Dashboard.GatheringRewardDestination"}}</span>
        <select name="gathering.rewardDestination">
          {{#each gatheringRewardDestinations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
    </div>
  </section>

  <section class="cmt-professions-section">
    <div class="cmt-section-heading">
      <h3><i class="fa-solid fa-hammer" aria-hidden="true"></i> {{localize "CMT.Settings.Dashboard.Professions"}}</h3>
    </div>
    <div class="cmt-profession-settings-list">
      {{#each professions}}
        <article class="cmt-profession-settings-card">
          <img src="{{img}}" alt="">
          <div><strong>{{name}}</strong><small>{{specialties}}</small></div>
          <button type="button" data-action="editProfession" data-profession-id="{{id}}">
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> {{localize "CMT.Settings.Dashboard.Edit"}}
          </button>
        </article>
      {{/each}}
    </div>
  </section>

  <section class="cmt-materials-section">
    <div class="cmt-section-heading">
      <h3><i class="fa-solid fa-gem" aria-hidden="true"></i> {{localize "CMT.Settings.Dashboard.Materials"}}</h3>
    </div>
    <div class="cmt-material-list">
      {{#each materials}}
        <article class="cmt-material-card {{#unless enabled}}is-disabled{{/unless}}">
          <div class="cmt-material-summary">
            <strong>{{label}}</strong><span>{{itemTypes}}</span><small>{{tiers}}</small>
          </div>
          <button type="button" data-action="editMaterial" data-material-id="{{id}}">
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> {{localize "CMT.Settings.Dashboard.Edit"}}
          </button>
        </article>
      {{/each}}
    </div>
  </section>

  <footer class="cmt-config-actions cmt-two-actions">
    <button type="button" data-action="reset" class="cmt-danger"><i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i> {{localize "CMT.Settings.Editor.Reset"}}</button>
    <button type="submit"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "CMT.Settings.Editor.Save"}}</button>
  </footer>
</div>
