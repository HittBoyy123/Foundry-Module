<div class="cmt-config-body cmt-json-editor">
  <p>{{localize "CMT.Settings.Advanced.Intro"}}</p>
  <p class="hint">{{localize "CMT.Settings.Advanced.Hint"}}</p>

  <label for="cmt-rules-json">{{localize "CMT.Settings.Editor.Label"}}</label>
  <textarea id="cmt-rules-json" name="config" spellcheck="false">{{configJson}}</textarea>

  <div class="cmt-config-actions cmt-two-actions">
    <button type="button" data-action="format">
      <i class="fa-solid fa-align-left" aria-hidden="true"></i>
      {{localize "CMT.Settings.Editor.Format"}}
    </button>
    <button type="submit">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      {{localize "CMT.Settings.Editor.Save"}}
    </button>
  </div>
</div>
