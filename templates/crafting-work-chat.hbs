<section class="cmt-chat-card cmt-crafting-chat">
  <header><i class="fa-solid fa-hammer" aria-hidden="true"></i> {{projectName}}</header>
  <p><strong>{{artisanName}}</strong> completed a {{days}}-day Work Block.</p>
  <dl>
    <div><dt>Crafting</dt><dd>{{rollTotal}} vs DC {{dc}}</dd></div>
    <div><dt>Result</dt><dd>{{degreeLabel}}</dd></div>
    <div><dt>Progress</dt><dd>{{progressBefore}} → {{progressAfter}} / {{requiredProgress}}</dd></div>
  </dl>
  {{#if ready}}<p class="cmt-chat-success"><i class="fa-solid fa-circle-check"></i> Ready for final confirmation.</p>{{/if}}
</section>
