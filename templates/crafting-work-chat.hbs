<section class="cmt-crafting-chat cmt-crafting-work-readout">
  <h3><i class="fa-solid fa-hammer" aria-hidden="true"></i> {{projectName}}</h3>
  <p><strong>{{artisanName}}</strong> · {{days}} days worked · <strong>{{daysEarned}} days earned</strong></p>
  {{#if craftingEdge}}
    <p class="cmt-work-effect"><strong>Crafting Edge — {{craftingEdge.name}}.</strong> {{craftingEdge.description}}</p>
    {{#if craftingEdge.fallback}}<p>Accelerated Work applies instead of a Masterstroke.</p>{{/if}}
  {{/if}}
  {{#if conservationCredit}}<p><strong>Conservation credit:</strong> up to 10% of one {{conservationCredit.itemName}} Resource Unit. Workshop use only; cannot be sold.</p>{{/if}}
  {{#if masterstroke}}<p class="cmt-work-effect"><strong>Masterstroke — {{masterstroke.name}}.</strong> {{masterstroke.description}}</p>{{/if}}
</section>
