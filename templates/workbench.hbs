<div class="cmt-workbench-body">
  {{#unless workbenchEnabled}}
    <p class="cmt-workbench-empty" role="status">{{localize "CMT.Workbench.FeatureDisabled"}}</p>
  {{else}}
  <header class="cmt-workbench-header">
    <div>
      <h2><i class="fa-solid fa-hammer" aria-hidden="true"></i> {{localize "CMT.Workbench.Heading"}}</h2>
      <p>{{localize "CMT.Workbench.Intro"}}</p>
    </div>
    <div class="cmt-workbench-party">
      <label>
        <span>{{localize "CMT.Workbench.Party"}}</span>
        <select data-cmt-workbench-field="party">
          {{#each parties}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{else}}
            <option value="">{{localize "CMT.Workbench.NoParty"}}</option>
          {{/each}}
        </select>
      </label>
      <button type="button" data-cmt-workbench-action="open-stash" {{#unless party}}disabled{{/unless}}>
        <i class="fa-solid fa-sack-dollar" aria-hidden="true"></i>
        {{localize "CMT.Workbench.OpenStash"}}
      </button>
    </div>
  </header>

  <nav class="cmt-workbench-tabs" aria-label="{{localize "CMT.Workbench.Heading"}}">
    <button type="button" data-cmt-workbench-tab="upgrade" class="{{#if tabs.upgrade}}active{{/if}}">Upgrade</button>
    <button type="button" data-cmt-workbench-tab="craft" class="{{#if tabs.craft}}active{{/if}}">
      <i class="fa-solid fa-hammer" aria-hidden="true"></i> {{localize "CMT.Workbench.Craft"}}
    </button>
    <button type="button" data-cmt-workbench-tab="gather" class="{{#if tabs.gather}}active{{/if}}">
      <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i> {{localize "CMT.Workbench.Gather"}}
    </button>
    <button type="button" data-cmt-workbench-tab="projects" class="{{#if tabs.projects}}active{{/if}}">
      <i class="fa-solid fa-list-check" aria-hidden="true"></i> {{localize "CMT.Workbench.Projects"}}
      <span>{{activeProjectCount}}</span>
    </button>
    <button type="button" data-cmt-workbench-tab="disassemble" class="{{#if tabs.disassemble}}active{{/if}}">
      <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Disassemble
    </button>
  </nav>

  {{#unless canEdit}}
    <div class="cmt-workbench-notice is-warning">
      <i class="fa-solid fa-lock" aria-hidden="true"></i> {{localize "CMT.Workbench.NotEditable"}}
    </div>
  {{/unless}}
  {{#unless craftingEnabled}}
    <div class="cmt-workbench-notice is-warning">
      <i class="fa-solid fa-ban" aria-hidden="true"></i> {{localize "CMT.Workbench.Disabled"}}
    </div>
  {{/unless}}

  {{#if tabs.disassemble}}
    <section class="cmt-workbench-panel cmt-workbench-projects">
      <div class="cmt-workbench-section-title"><h3>Disassemble Items</h3><span>50% material return</span></div>
      <div class="cmt-disassembly-summary">
        <div class="cmt-workbench-drop cmt-disassembly-drop" data-cmt-disassembly-drop aria-label="Drop items to disassemble">
          <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>
          <strong>Disassemble Item</strong>
        </div>
        <section class="cmt-disassembly-totals" aria-live="polite">
          <h4>Total Materials Returned</h4>
          <ul>{{#each disassemblyTotals}}<li>{{name}} — Tier {{tier}}: <strong>{{quantity}}</strong></li>{{else}}<li>Add items to preview their combined returns.</li>{{/each}}</ul>
        </section>
        {{#if disassemblyQueueCount}}
          <div class="cmt-disassembly-queue-actions">
            <button type="button" data-cmt-disassembly-batch>Review &amp; Disassemble Queue…</button>
            <button type="button" data-cmt-disassembly-clear-queue>Clear Queue</button>
          </div>
        {{/if}}
      </div>
      <p>50% material return, rounded up for each stack. Items and their Marks are destroyed only after confirmation.</p>
      {{#if disassemblyQueueCount}}<p>{{disassemblyQueueCount}} stacks queued. Drop more items to add them.</p>{{/if}}
      {{#each disassemblyQueue}}
        <article class="cmt-panel">
          <h4 class="cmt-disassembly-item-title">{{itemName}}{{#if stackQuantity}} × {{stackQuantity}}{{/if}}</h4>
          {{#if error}}<p class="cmt-workbench-notice is-warning">{{error}} Remove this entry before processing the queue.</p>{{else}}
          <p>From: {{sourceName}}</p>
          <p>{{#if basis}}{{basis}}{{else}}Recorded crafting materials{{/if}}</p>
          <ul>{{#each returns}}<li>{{name}} — Tier {{tier}}: {{consumed}} units → <strong>{{quantity}} returned</strong></li>{{/each}}</ul>
          {{/if}}
          <div class="cmt-workbench-actions"><button type="button" data-cmt-disassembly-clear="{{uuid}}">Remove from Queue</button><button type="button" data-cmt-disassembly-confirm="{{uuid}}" {{#unless canDisassemble}}disabled{{/unless}}>Disassemble…</button></div>
        </article>
      {{/each}}
      <h4 class="cmt-disassembly-list-title">Completed items already in the Party Stash</h4>
      {{#each disassemblyItems}}
        <article class="cmt-panel">
          <h4 class="cmt-disassembly-item-title">{{itemName}}</h4>
          {{#if error}}<p class="cmt-workbench-notice is-warning">{{error}}</p>{{/if}}
          <ul>{{#each returns}}<li>{{name}} — Tier {{tier}}: {{consumed}} used → <strong>{{quantity}} returned</strong></li>{{/each}}</ul>
          <div class="cmt-workbench-actions"><button type="button" data-cmt-disassemble="{{projectId}}" {{#unless canDisassemble}}disabled{{/unless}}>
            <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Disassemble…
          </button></div>
        </article>
      {{else}}<p>No recorded outputs in the Party Stash. You can still drop a formatted GM-created item above. Unequip the items first. Each queued entry dismantles its entire stack.</p>{{/each}}
    </section>
  {{/if}}

  {{#if tabs.craft}}
    {{#if tabs.upgrade}}
      <p class="cmt-workbench-notice">Upgrade an existing item: 25% fewer replacement materials (rounded up), 25% less component work. Existing Marks stay free; new Marks cost full price. Replaced materials are lost. The item is locked until completion or cancellation.</p>
      {{#if upgradeError}}<p class="cmt-workbench-notice is-warning">{{upgradeError}}</p>{{/if}}

      {{#if retainedMarks}}
        <p>Existing Marks (retained with original makers): {{#each retainedMarks}}{{name}}; {{/each}}</p>
        <label>One free Mark rearrangement <select data-cmt-reanchor-mark>{{#each retainedMarks}}<option value="{{definitionId}}">{{name}}</option>{{/each}}</select></label>
        <label>New compatible anchor <select data-cmt-reanchor-anchor>{{#each upgradeAnchors}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>
        <button type="button" data-cmt-reanchor>Preview Rearrangement</button>
      {{/if}}
    {{/if}}
    <section class="cmt-workbench-panel cmt-workbench-craft">
      <div class="cmt-workbench-section-title">
        <h3>{{localize "CMT.Workbench.NewProject"}}</h3>
        <span>{{localize "CMT.Workbench.Planning"}}</span>
      </div>

      <div class="cmt-crafting-summary">
        <div class="cmt-crafting-setup">
      <div class="cmt-workbench-drop {{#if baseItem}}is-filled{{/if}}" data-cmt-workbench-drop="base-item">
        {{#if baseItem}}
          <img src="{{baseItem.img}}" alt="">
          <div>
            <strong>{{baseItem.name}}</strong>
            <span>{{baseItem.categoryLabel}}{{#if baseItem.traitSummary}} · {{baseItem.traitSummary}}{{/if}}</span>
          </div>
          <button type="button" data-cmt-workbench-action="clear-base" title="{{localize "CMT.Workbench.ClearBase"}}">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        {{else}}
          <i class="fa-solid fa-box-open" aria-hidden="true"></i>
          <div>
            <strong>{{localize "CMT.Workbench.DropBase"}}</strong>
            <span>{{localize "CMT.Workbench.DropBaseHint"}}</span>
          </div>
        {{/if}}
      </div>

      <div class="cmt-workbench-form-grid">
        <label>
          <span>{{localize "CMT.Workbench.ProjectName"}}</span>
          <input type="text" data-cmt-workbench-field="project-name" value="{{draft.name}}" placeholder="{{localize "CMT.Workbench.ProjectNamePlaceholder"}}">
        </label>
        <label>
          <span>{{localize "CMT.Workbench.Recipe"}}</span>
          <select data-cmt-workbench-field="recipe" {{#unless baseItem}}disabled{{/unless}}>
            {{#each recipeBands}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{else}}
              <option value="">{{localize "CMT.Workbench.NoRecipes"}}</option>
            {{/each}}
          </select>
        </label>
        <label>
          <span>{{localize "CMT.Workbench.CoreMaterial"}}</span>
          <select data-cmt-workbench-field="material" {{#unless selectedBand}}disabled{{/unless}}>
            {{#each coreMaterials}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <label>
          <span>{{localize "CMT.Workbench.CoreTier"}}</span>
          <select data-cmt-workbench-field="tier">
            {{#each tiers}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>Tier {{value}} — {{label}}</option>
            {{/each}}
          </select>
        </label>
      </div>


      <div class="cmt-workbench-form-grid">
        <label><span>Equipment Size</span>
          <select data-cmt-workbench-field="equipment-size" {{#if tabs.upgrade}}disabled{{/if}}>
            {{#each equipmentSizes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
      </div>
      <div class="cmt-workbench-form-grid">
        {{#each secondaryMaterials}}
          <label><span>{{label}} material</span><select data-cmt-secondary="{{id}}">
            {{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select></label>
          {{#if ../tabs.upgrade}}<label>{{label}} Tier <input type="number" min="1" max="6" value="{{upgradeTier}}" data-cmt-upgrade-tier="{{id}}"></label>{{/if}}
        {{/each}}
        {{#if upgradeDragonAvailable}}
          <label class="cmt-dragon-scale-field"><span>Dragon Scales</span>
            <select data-cmt-dragon-scale>
              <option value="">No new resistance</option>
              {{#each upgradeDragonOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if unavailable}}disabled{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
        {{/if}}
        <button type="button" class="cmt-start-crafting" data-cmt-workbench-action="create-project" {{#unless canCreate}}disabled{{/unless}}>
          <i class="fa-solid fa-hammer" aria-hidden="true"></i>
          <strong>{{#if tabs.upgrade}}Upgrade{{else}}Craft{{/if}}</strong>
        </button>
      </div>
        </div>
        <section class="cmt-crafting-materials" aria-live="polite">
          <h4>Total Materials Required</h4>
          {{#if preview}}
            <p>Includes selected Artisan Marks and equipment size. Available stock excludes reserved materials.</p>
            <ul>
              {{#each preview.materials}}
                <li class="{{#unless alternative}}{{#if available}}is-valid{{else}}is-invalid{{/if}}{{/unless}}">
                  <strong>{{label}}</strong>
                  {{#unless alternative}}<span>{{units}} required · {{owned}} available{{#if missing}} · {{missing}} missing{{/if}}</span>{{/unless}}
                </li>
              {{/each}}
            </ul>
            <p>DC {{preview.check.dc}} · Days required: {{estimatedDays}}</p>
            <p class="cmt-crafting-duration-hint">Based on successful checks by the selected team. Critical successes can shorten this; failed checks can extend it.</p>
            <strong>{{#if preview.craftable}}{{localize "CMT.Workbench.ReadyToReserve"}}{{else}}{{localize "CMT.Workbench.MissingResources"}}{{/if}}</strong>
          {{else}}
            {{#if upgradeError}}<p class="cmt-workbench-notice is-warning">{{upgradeError}}</p>{{else}}<p>Drop an item to see its material requirements.</p>{{/if}}
          {{/if}}
        </section>
      </div>


      <section class="cmt-workbench-contributors">
        <div class="cmt-workbench-section-title"><h3 class="cmt-artisan-heading">Artisans involved <span class="cmt-artisan-capacity-pips" role="img" aria-label="{{markCapacity.remaining}} of {{markCapacity.maximum}} Mark capacity available" title="{{markCapacity.remaining}} of {{markCapacity.maximum}} Mark capacity available">{{#each markCapacity.segments}}<i class="{{#if used}}is-used{{/if}}" aria-hidden="true"></i>{{/each}}</span></h3><span>Up to six artisans</span></div>
        <div class="cmt-artisan-slots">
          {{#each artisanSlots}}
            <article class="cmt-artisan-slot" data-cmt-artisan-slot="{{index}}">
              <header><strong>{{role}}</strong><small>{{#if required}}Required{{else}}Optional{{/if}}</small></header>
              <span class="cmt-slot-requirement">{{requirement}}</span>
              {{#if actorUuid}}
                <div class="cmt-artisan-identity">
                  <button type="button" class="cmt-artisan-portrait" data-cmt-open-marks="{{actorUuid}}" title="Choose Artisan Marks for {{name}}" aria-label="Choose Artisan Marks for {{name}}">
                    <img src="{{img}}" alt="">
                  </button>
                  <div class="cmt-artisan-text"><strong>{{name}}</strong><span>{{professionSummary}}</span>
                    {{#if specializationSummary}}<small>{{specializationSummary}}</small>{{/if}}
                  </div>
                </div>
                <div class="cmt-slot-actions"><button type="button" data-cmt-open-marks="{{actorUuid}}">Choose Marks</button>
                <button type="button" data-cmt-slot-remove="{{index}}" title="Remove artisan" aria-label="Remove artisan"><i class="fa-solid fa-xmark"></i></button></div>
                <div class="cmt-mark-badges">
                  {{#each marks}}<button type="button" data-cmt-mark-detail="{{definitionId}}" title="{{effectSummary}}">{{name}} · {{capacityCost}}<small>{{profession}} — {{#if specialisation}}{{specialisation}}{{else}}Universal{{/if}}</small></button>{{/each}}
                </div>
              {{else}}
                <div class="cmt-slot-empty"><i class="fa-solid fa-user-plus"></i><span>Drop artisan</span></div>
              {{/if}}
            </article>
          {{/each}}
        </div>
      </section>
      {{#each teamReasons}}<p class="cmt-workbench-notice is-warning">{{this}}</p>{{/each}}
    </section>
  {{/if}}

  {{#if tabs.gather}}
    <section class="cmt-gathering-app cmt-workbench-gather">{{{gatheringHtml}}}</section>
  {{/if}}

  {{#if tabs.projects}}
    <section class="cmt-workbench-panel cmt-workbench-projects">
      <div class="cmt-workbench-section-title">
        <h3>{{localize "CMT.Workbench.ProjectLedger"}}</h3>
        <button type="button" data-cmt-show-archived>{{#if showArchived}}Back to projects{{else}}Archive ({{archivedCount}}){{/if}}</button>
      </div>
      {{#if showArchived}}
        <nav class="cmt-workbench-tabs" aria-label="Project archive">
          <button type="button" data-cmt-archive-tab="crafted" class="{{#if archiveCrafted}}active{{/if}}" aria-pressed="{{archiveCrafted}}">Crafted ({{craftedArchiveCount}})</button>
          <button type="button" data-cmt-archive-tab="disassembled" class="{{#if archiveDisassembled}}active{{/if}}" aria-pressed="{{archiveDisassembled}}">Disassembled ({{disassembledArchiveCount}})</button>
        </nav>
      {{/if}}
      <div class="cmt-project-browser">
        <div class="cmt-project-list" data-cmt-project-list aria-label="Crafting projects">
          {{#each projects}}
            <button type="button" class="cmt-project-list-entry {{#if selected}}is-selected{{/if}}" data-cmt-select-project="{{id}}" aria-pressed="{{selected}}">
              <span class="cmt-project-list-heading"><img src="{{baseItemImg}}" alt=""><strong>{{name}}</strong></span>
              <span class="cmt-project-day-pips" aria-hidden="true">{{#each dayPips}}<i class="{{#if completed}}is-complete{{/if}}"></i>{{/each}}</span>
              <span>{{daysCompleted}} of {{daysTotal}} days completed · {{daysRemaining}} remaining</span>
            </button>
          {{else}}<p>{{localize "CMT.Workbench.NoProjects"}}</p>{{/each}}
        </div>
        <div class="cmt-project-detail-pane" aria-label="Selected project">
          {{#with selectedProject}}
        <article class="cmt-workbench-project {{statusClass}}" data-cmt-project-id="{{id}}">
          <header>
            <img src="{{baseItemImg}}" alt="">
            <div>
              <h4>{{name}}</h4>
              {{#if hasHistoryDate}}<span>{{historyDateLabel}}: {{historyDate}}</span>{{else}}<span>Completion date: Not yet completed</span>{{/if}}
              <span>{{recipeName}} · {{coreLabel}}</span>
            </div>
            <span class="cmt-workbench-status">{{statusLabel}}</span>
            {{#if canArchive}}<button type="button" data-cmt-project-action="archive" title="{{#if archived}}Restore{{else}}Archive{{/if}}" aria-label="Archive or restore"><i class="fa-solid fa-box-archive"></i></button>{{/if}}
            {{#if canCancel}}
              <button type="button" data-cmt-project-action="cancel" title="Cancel project" aria-label="Cancel project"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            {{else}}
              {{#if canManage}}<button type="button" data-cmt-project-action="remove" title="Remove project" aria-label="Remove project"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{/if}}
            {{/if}}
          </header>
          <div class="cmt-project-detail-body">
          <div class="cmt-workbench-project-stats">
            <span><strong>{{daysCompleted}} of {{daysTotal}} days completed</strong> · {{daysRemaining}} remaining</span>
            <span>{{teamSize}} artisan(s) · {{estimatedDays}} successful work days remaining</span>
            <span><strong>{{reservationCount}}</strong> {{localize "CMT.Workbench.ReservedStacks"}}</span>
            <span><strong>{{markCount}}</strong> Artisan Marks</span>
          </div>
          {{#if nextWorkBonus}}<p><strong>Stable Integration:</strong> +2 circumstance bonus to the next Work Block.</p>{{/if}}
          {{#if masterstrokes.length}}<details open><summary>Masterstrokes</summary><ul>
            {{#each masterstrokes}}<li><span><strong>{{name}}</strong> — {{description}}</span></li>{{/each}}
          </ul></details>{{/if}}
          {{#if conservationCredits.length}}<details><summary>Workshop Conservation Credits</summary><ul>
            {{#each conservationCredits}}<li><span>{{itemName}} · up to 10% of one Resource Unit’s consumable value. Non-sellable. {{#if used}}Used{{else}}Available{{/if}}</span>{{#unless used}}{{#if ../canManage}}<button type="button" data-cmt-use-credit="{{id}}">Use Credit</button>{{/if}}{{/unless}}</li>{{/each}}
          </ul></details>{{/if}}
          {{#if contributorSummary}}<p class="cmt-workbench-project-artisans"><strong>Artisans:</strong> {{contributorSummary}}</p>{{/if}}
          {{#if artisanMarks.length}}
            <details open>
              <summary>Artisan Marks</summary>
              <ul>
                {{#each artisanMarks}}
                  <li><button type="button" data-cmt-mark-detail="{{definitionId}}" title="{{effectSummary}}">{{name}} — {{maker.name}}<small>{{profession}} — {{#if specialisation}}{{specialisation}}{{else}}Universal{{/if}}</small></button><strong>{{capacityCost}} Capacity</strong></li>
                {{/each}}
              </ul>
            </details>
          {{/if}}
          {{#if reservations.length}}
            <details open>
              <summary>Materials</summary>
              <ul>
                {{#each reservations}}
                  <li><span>{{itemName}}</span><strong>{{quantity}} × ({{units}} units)</strong></li>
                {{/each}}
              </ul>
            </details>
          {{/if}}
          {{#if canWork}}
            <div class="cmt-workbench-work-block">
              <label>
                <span>{{localize "CMT.Workbench.WorkBlock"}}</span>
                <select data-cmt-project-field="days">
                  <option value="1">1 day</option>
                  <option value="2">2 days</option>
                  <option value="3">3 days</option>
                  <option value="4">4 days</option>
                  <option value="5" selected>5 days</option>
                </select>
              </label>
              <button type="button" data-cmt-project-action="roll-work">
                <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
                {{localize "CMT.Workbench.RollWork"}}
              </button>
            </div>
          {{/if}}
          <footer>
            {{#if canRecover}}
              <button type="button" data-cmt-project-action="recover"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Recover Missing Item</button>
            {{/if}}
            {{#if canComplete}}
              <button type="button" data-cmt-project-action="complete" class="primary">
                <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                {{localize "CMT.Workbench.CompleteProject"}}
              </button>
            {{/if}}
          </footer>
          </div>
        </article>
          {{else}}<p>Select a project to view its details.</p>{{/with}}
        </div>
      </div>

    </section>
  {{/if}}
  {{/unless}}
</div>
