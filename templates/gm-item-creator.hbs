<div class="cmt-workbench-body">
  <header class="cmt-workbench-header"><div>
    <h2>GM Item Creator</h2>
    <p>Create a world item. No materials, projects, or downtime are spent.</p>
  </div></header>
  <section class="cmt-workbench-panel">
    <div class="cmt-workbench-section-title"><h3>Base Item &amp; Materials</h3></div>
    <div class="cmt-workbench-drop" data-base-drop>
      {{#if base}}<strong>{{base.name}}</strong><span>Drop another base item to replace it.</span>{{else}}Drop a PF2e weapon, armor, shield, or Spell Focus here.{{/if}}
    </div>
    <div class="cmt-workbench-form-grid">
      <label>Item name<input type="text" name="itemName" value="{{draft.name}}"></label>
      <label>Artisan name<input type="text" name="maker" value="{{draft.maker}}" placeholder="Any name; no Actor needed"></label>
      {{#if plan}}
        <label>Core Material<select data-core="materialId">{{#each materials}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label>Core Tier<select data-core="tier">{{#each tiers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>Tier {{value}} — {{label}}</option>{{/each}}</select></label>
        {{#each components}}
          <label>{{label}}<select data-component="{{id}}" data-part="materialId">{{#each materials}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label>{{label}} Tier<select data-component="{{id}}" data-part="tier">{{#each tiers}}<option value="{{value}}" {{#if selected}}selected{{/if}}>Tier {{value}}</option>{{/each}}</select></label>
        {{/each}}
      {{/if}}
    </div>
  </section>
  {{#if error}}<p class="cmt-workbench-notice is-warning">{{error}}</p>{{/if}}
  {{#if base}}
    <div class="cmt-workbench-actions"><button type="button" data-create {{#unless plan}}disabled{{/unless}}>Create World Item</button></div>
  {{/if}}
</div>
