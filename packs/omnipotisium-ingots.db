{"_id":"WmCraftRes000067","img":"icons/commodities/metal/ingot-stack-steel-green.webp","name":"Omnipotentium Ingots","sort":6700000,"system":{"baseItem":null,"bulk":{"value":0.2,"heldOrStowed":0.2},"containerId":null,"description":{"value":"<p>An exceptionally rare, GM-awarded crafting material. It cannot be obtained through gathering and has no standard market or sale value.</p><p>Weapons made with this Core bypass Voidborn half-damage protection. Armour made with it halves damage received from Voidborn attackers while worn. Each ingot is one Resource Unit.</p>"},"equipped":{"carryType":"worn"},"hardness":0,"hp":{"max":0,"value":0},"level":{"value":20},"material":{"grade":null,"type":null},"price":{"value":{"gp":0},"per":1,"sizeSensitive":false},"publication":{"license":"ORC","remaster":true,"title":"Wrathmaker"},"quantity":1,"rules":[],"size":"med","stackGroup":null,"traits":{"otherTags":["wrathmaker-resource","material-omnipotisium","material-tier-7"],"rarity":"unique","value":["precious"]}},"type":"equipment","flags":{"pf2e-crafting-material-tiers":{"resource":{"schemaVersion":2,"materialId":"omnipotisium","family":"omnipotisium","tier":7,"unit":"ingot","unitsPerItem":1,"variantId":"","bundleSize":1,"pricePerUnitGp":0,"tags":["wrathmaker-resource","material-omnipotisium","material-tier-7"],"nativeEffects":[],"eligibleItemTags":[],"specialisationHooks":[]}}}}
